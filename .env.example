BETTER_AUTH_SECRET=   # openssl rand -hex 32 (required in production)
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=         # Postgres (Neon). Empty = PGlite fallback (ephemeral on Vercel)
MODEL_API_KEY=        # Meta Model API key (server-only). Empty = labeled mocks
META_MODEL_API_BASE=https://api.meta.ai/v1
SEAMLESS_ENDPOINT=    # optional self-hosted SeamlessM4T v2 endpoint
ADMIN_EMAILS=         # comma list; else first user becomes admin
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# --- Next-gen upgrade ---
NV_MODEL=                 # optional override for the NVIDIA fallback model id
PAYSTACK_SECRET_KEY=      # server-only; NGN checkout (stub until set)
STRIPE_SECRET_KEY=        # server-only; USD checkout (stub until set)
SCADA_MCP_URL=            # optional HTTPS MCP endpoint for plant connections (read-only by default)
SCADA_MCP_TOKEN=          # server-only bearer token for that endpoint; never put in the browser
